# The HyperJump platform: where "apply" and "sign in" go, and where the past jumpers
# cards are loaded from (GET /api/public/jumpers). Read at build time.
VITE_APP_URL=https://hyperjump.dev

# PostHog browser analytics. Set these from your PostHog project settings.
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://your-posthog-host
